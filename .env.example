# Server
PORT=3001

# LLM API (DeepSeek)
DEEPSEEK_API_KEY=sk-your-key-here

# Admin JWT Secret (optional, default provided)
ADMIN_JWT_SECRET=pptx-admin-secret

# ─── Payment ──────────────────────────────────────────────
# Mode: auto (wechat > alipay > mock) | wechat | alipay | mock
PAYMENT_MODE=auto

# ─── WeChat Pay (v3 Native) ───────────────────────────────
# WECHAT_APP_ID=wx1234567890abcdef
# WECHAT_MCH_ID=1600000000
# WECHAT_API_V3_KEY=your-32-byte-api-v3-key
# WECHAT_MCH_SERIAL_NO=1234567890ABCDEF
# WECHAT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
# WECHAT_PRIVATE_KEY_PATH=./certs/apiclient_key.pem
# WECHAT_NOTIFY_URL=https://your-domain.com/api/payments/notify/wechat
# WECHAT_PLATFORM_CERT=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----

# ─── Alipay ───────────────────────────────────────────────
# ALIPAY_APP_ID=2021000000000000
# ALIPAY_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----
# ALIPAY_ALIPAY_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----
# ALIPAY_NOTIFY_URL=https://your-domain.com/api/payments/notify/alipay
# ALIPAY_RETURN_URL=https://your-domain.com/payment/success
